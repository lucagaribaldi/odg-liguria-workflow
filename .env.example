# ODG Liguria Workflow Environment Variables
# Copy this file to .env and set your actual values

# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=your-secret-key-here

# Email Configuration
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=your-email@example.com
EMAIL_IMAP_PASSWORD=your-app-password
EMAIL_IMAP_FOLDER=INBOX

EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your-email@example.com
EMAIL_SMTP_PASSWORD=your-app-password

# Database
DATABASE_URL=sqlite:///data/odg_workflow.db

# File Paths
DATA_INPUT_DIR=data/input
DATA_OUTPUT_DIR=data/output
DATA_BACKUP_DIR=data/backups
TEMP_DIR=temp
LOG_DIR=logs

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/odg_workflow.log

# Security
ENCRYPTION_KEY=your-encryption-key-here
JWT_SECRET=your-jwt-secret-here
SESSION_TIMEOUT=3600

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000

# Processing Settings
MAX_EMAILS_PER_BATCH=50
EMAIL_CHECK_INTERVAL=300
ATTACHMENT_MAX_SIZE=10485760

# Monitoring
MONITORING_ENABLED=true
METRICS_RETENTION_DAYS=30

# External Services (if needed)
# API_SERVICE_URL=https://api.example.com
# API_SERVICE_KEY=your-api-key
# API_SERVICE_TIMEOUT=30

# Backup Settings
BACKUP_ENABLED=true
BACKUP_INTERVAL=3600
BACKUP_RETENTION_DAYS=7

# Workflow Settings
WORKFLOW_RETRY_MAX_ATTEMPTS=3
WORKFLOW_RETRY_BACKOFF_FACTOR=2
WORKFLOW_TIMEOUT=300